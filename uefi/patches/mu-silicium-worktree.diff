diff --git a/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c b/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
index d2844e0a..33f0aba7 100644
--- a/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
+++ b/Silicon/Silicium/SiliciumPkg/Library/FrameBufferSerialPortLib/FrameBufferSerialPortLib.c
@@ -248,6 +248,8 @@ SerialPortWrite (
   EFI_PHYSICAL_ADDRESS FbBase;
   UINT64               FbLength;
 
+  CONST UINT8 *HakiosMessage = Buffer;
+
   // Get Frame Buffer Memory
   Status = GetFrameBufferMemory (&FbBase, &FbLength);
   if (EFI_ERROR (Status)) {
@@ -272,8 +274,15 @@ SerialPortWrite (
     ArmEnableInterrupts ();
   }
 
-  // Flush Frame Buffer
-  WriteBackInvalidateDataCacheRange ((VOID *)FbBase, FbLength);
+  // HakiOS: no flush of the whole 43 MB region for every message. The mapping is write-through, so nothing needs it,
+  // and on mayfly the display engine stopped scanning out under that load.
+
+  // HakiOS bring-up: count the writes where the boot shim's heartbeat CPU can read them
+  (*(volatile UINT32 *)0xA7001000)++;
+  if (HakiosMessage[0] == 'L' && HakiosMessage[8] == 'd' && HakiosMessage[9] == 'r') {
+    (*(volatile UINT32 *)0xA7001004)++;   // "Loading driver"
+  }
+  WriteBackInvalidateDataCacheRange ((VOID *)0xA7001000, 8);
 
   return NumberOfBytes;
 }
