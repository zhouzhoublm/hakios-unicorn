# HakiOS fragment: the Xiaomi 12S Pro (unicorn) -- what is true of this device and of no other.
#
# Where this port is: stage 0, the UEFI (uefi/files/Platforms/Xiaomi/unicornPkg) and the firmware
# story are written; the kernel has not been built for this phone and nothing has been started on it.
# Following docs/porting/index.md step 2, every phone driver of the common repository is left out
# while the phone is brought up with nothing of its own; step 3 brings them back one at a time, in the
# order that page gives. What each driver needs to become unicorn's is in its drivers/*/conf.
CONFIG_DEVICE="unicorn"

# The storage: UEFI has no UFS driver here, the loader takes the controller over from ABL and reads
# for the kernel (the same SM8475 UFS host, 0x1d84000, in this phone's own tree).
CONFIG_HAKIOS_UFS=y
CONFIG_UFS=2

# --- Step 3 of the port, one at a time; each needs a change first (drivers/*/conf says what) --------
# CONFIG_HAKIOS_CPUFREQ is not set        # the SoC's; check the EPSS bases against unicorn's tree
# CONFIG_HAKIOS_THERMAL is not set        # TSENS 0xc263000/0xc265000 and the PMIC ADC channels
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_BUTTONS is not set        # power and volume through the PMIC arbiter v7
# CONFIG_HAKIOS_STFTS is not set          # ST FTS on SPI SE4: coordinate ranges must become unicorn's
# CONFIG_HAKIOS_ADRENO7 is not set        # Adreno 730: mayfly's driver, panel and Wi-Fi parts are mayfly's
# CONFIG_HAKIOS_GPU is not set
# CONFIG_HAKIOS_ADSP is not set           # needed before audio and the battery's level
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_SPEAKER is not set        # the amplifiers are Cirrus CS35L41 here, not Awinic AW88261
# CONFIG_HAKIOS_BATTERY is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_QCA6490 is not set        # the QCA6490's firmware talk, before the Wi-Fi stack
# CONFIG_HAKIOS_WIFI_STACK is not set
# CONFIG_HAKIOS_QCABT is not set          # the QCA6490's Bluetooth over the SE20 UART
# CONFIG_HAKIOS_HAPTIC is not set         # Awinic AW8697 on I2C SE18, not the PMIC
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_MODEM is not set

# The switches the common kernel reads: all off until the driver that reads them is in.
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set

# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
