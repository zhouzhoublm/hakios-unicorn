# HakiOS fragment: the Xiaomi 12S (mayfly) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="mayfly"
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
CONFIG_HAKIOS_QCABT=y
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_SOCINFO is not set
# CONFIG_HAKIOS_ADRENO is not set
# the Adreno 730: its own driver, started only by adreno7=N
CONFIG_HAKIOS_ADRENO7=y
# the service the window server draws through (gpu=1: ADRENO7 keeps the GPU on for it)
CONFIG_HAKIOS_GPU=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# the touch screen: built in, started only by touchscreen=1 (CONFIG_TOUCHSCREEN), which stays off until the first boot reaches launchd
CONFIG_HAKIOS_STFTS=y
# power and volume keys: PMIC reads only
CONFIG_HAKIOS_BUTTONS=y
CONFIG_HAKIOS_QMI=y
# the QCA6490's firmware talk (wifi_pcie=11)
CONFIG_HAKIOS_QCA6490=y
# CONFIG_HAKIOS_MODEM is not set
CONFIG_HAKIOS_BATTERY=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# CONFIG_HAKIOS_PMIC is not set
# CONFIG_HAKIOS_BATTGUARD is not set
# the storage: UEFI has no UFS driver here, the loader takes the controller over from ABL and reads for the kernel
CONFIG_HAKIOS_UFS=y
# CONFIG_HAKIOS_WIFI is not set
CONFIG_HAKIOS_WIFI_STACK=y
# CONFIG_TOUCHSCREEN is not set
# CONFIG_GPU is not set
# CONFIG_ADSP is not set
# CONFIG_SOUND is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
CONFIG_UFS=2
